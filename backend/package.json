{
  "name": "@platform/backend",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Supply Chain & Procurement Platform - backend (Express + TypeScript + MongoDB)",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "node --env-file=.env.presentation scripts/run-real-coverage.mjs",
    "test:coverage:unit": "jest --coverage",
    "test:coverage:real": "node --env-file=.env.presentation scripts/run-real-coverage.mjs",
    "test:integration": "tsx --env-file=.env.presentation scripts/real-regression.ts",
    "test:low-stock": "node --env-file=.env.presentation scripts/run-low-stock-test.mjs",
    "test:subscriptions": "node --env-file=.env.presentation scripts/run-stripe-test.mjs",
    "test:payment:stripe": "node --env-file=.env.presentation scripts/run-stripe-test.mjs",
    "test:payment:renewals": "node --env-file=.env.presentation scripts/run-stripe-renewal-test.mjs",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "demo:db": "tsx scripts/local-demo-db.ts",
    "demo:setup": "node scripts/setup-presentation.mjs",
    "demo:smtp": "tsx --env-file=.env.presentation scripts/demo-smtp.ts",
    "demo:api": "tsx --env-file=.env.presentation src/server.ts",
    "demo:worker": "tsx --env-file=.env.presentation src/worker.ts",
    "demo:stripe": "node --env-file=.env.presentation scripts/stripe-webhooks.mjs",
    "seed:garments": "tsx --env-file=.env.presentation scripts/garments-demo.ts",
    "demo:postman": "tsx scripts/build-demo-postman.ts",
    "demo:ready": "tsx --env-file=.env.presentation scripts/prepare-presentation.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "seed:notifications": "tsx --env-file=.env scripts/seedNotifications.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@langchain/core": "^1.1.42",
    "@langchain/google-genai": "^2.1.29",
    "@langchain/groq": "^1.2.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@sparticuz/chromium": "^148.0.0",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.34.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.3.5",
    "mongoose": "8.24.1",
    "multer": "^2.2.0",
    "nanoid": "^5.0.9",
    "nodemailer": "^10.1.2",
    "pdfkit": "^0.18.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "puppeteer-core": "^25.14.0",
    "rate-limit-redis": "^4.2.0",
    "resend": "^4.0.1",
    "socket.io": "^4.8.1",
    "stripe": "^23.0.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "overrides": {
    "ioredis": "5.11.1",
    "handlebars": "^4.7.10"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^8.57.1",
    "eslint-plugin-boundaries": "^5.4.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "mongodb-memory-server": "^10.1.2",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "smtp-server": "^3.19.23",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
