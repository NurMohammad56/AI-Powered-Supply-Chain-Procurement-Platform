{
  "info": {
    "name": "Bangladesh Garments - Verified Presentation Workflow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run Login, then folder 02 for a read-only presentation. Folder 03 is a complete new PO workflow. Run remaining folders manually as documented in MANUAL-TEST-WORKFLOW.bn.md. Data and pricing are synthetic; AI output is generated by real providers."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(pm.request.method==='POST') pm.request.headers.upsert({key:'Idempotency-Key',value:pm.variables.replaceIn('{{$guid}}')});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Login",
      "item": [
        {
          "name": "Login as demo owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.expect([200]).to.include(pm.response.code));",
                  "if (pm.response.code < 300) { const d=pm.response.json().data; pm.environment.set('accessToken',d.accessToken); pm.environment.set('userId',d.user.id); }"
                ]
              }
            }
          ]
        }
      ]
    },
