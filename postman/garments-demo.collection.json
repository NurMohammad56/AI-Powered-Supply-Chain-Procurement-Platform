    {
      "name": "03 - Complete new PO workflow",
      "item": [
        {
          "name": "Create draft PO (100 kg cotton)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/purchase-orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"currency\": \"BDT\",\n  \"paymentTermsDays\": 30,\n  \"expectedDeliveryAt\": \"{{future}}\",\n  \"lines\": [\n    {\n      \"itemId\": \"{{itemId}}\",\n      \"quantityOrdered\": 100,\n      \"unitPrice\": 480\n    }\n  ],\n  \"taxRate\": 0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.expect([200,201,202,204]).to.include(pm.response.code));",
                  "if (pm.response.code < 300) { const d=pm.response.json().data; pm.environment.set('poId',d.id); pm.environment.set('poLineId',d.lines[0].id); }"
                ]
              }
